# From scope to proposal
research_hours = 18
build_hours = 64
review_hours = 12
hourly_rate = $145
total_hours = research_hours + build_hours + review_hours
work = total_hours * hourly_rate
expenses = $1,275.50
proposal = work + expenses

## A discount, then a contingency
repeat_client = 8%
discounted = proposal - repeat_client
reserve = 15%
quoted = discounted + reserve
deposit = 40% of quoted
balance = quoted - deposit

### Split the delivery
milestone_payment = balance / 3
