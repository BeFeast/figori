{
  "name": "figori",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit && bun run --cwd packages/rates typecheck && bun run --cwd packages/document typecheck && bun run --cwd packages/tui typecheck",
    "build": "bun build packages/cli/src/index.ts --target=bun --outdir=dist",
    "cli": "bun packages/cli/src/index.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "author": "BeFeast",
  "homepage": "https://figori.befeast.com",
  "repository": {
    "type": "git",
    "url": "https://git.oklabs.uk/BeFeast/figori.git"
  }
}
